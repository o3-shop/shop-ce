{
    "name": "o3-shop/shop-ce",
    "description": "This package contains O3-Shop CE source code.",
    "type": "oxideshop",
    "keywords": ["o3-shop", "modules", "eShop"],
    "homepage": "https://www.o3-shop.com/",
    "license": "GPL-3.0-only",
    "author": [
        {
            "name": "OXID eSales AG",
            "email": "info@oxid-esales.com",
            "homepage": "https://oxid-esales.com",
            "role": "Developer"
        },
        {
            "name": "O3-Shop",
            "email": "info@o3-shop.com",
            "homepage": "https://www.o3-shop.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-pdo": "*",
        "ext-json": "*",
        "phpmailer/phpmailer": "^v6.5.0",
        "o3-shop/smarty": "~2.6.34",
        "doctrine/dbal": "^3.9",
        "doctrine/collections": "^1.4 || ^2.0",
        "monolog/monolog": "^v2.10",
        "psr/container": "^1.0 || ^2.0",
        "symfony/event-dispatcher": "^5.4",
        "symfony/dependency-injection": "^5.4",
        "symfony/config": "^5.4",
        "symfony/yaml": "^5.4",
        "symfony/expression-language": "^5.4",
        "symfony/lock": "^5.4",
        "symfony/console": "^5.4",
        "webmozart/path-util": "^2.3",
        "symfony/finder": "^5.4",
        "symfony/filesystem": "^5.4",
        "vlucas/phpdotenv": "^5.5",
        "o3-shop/shop-doctrine-migration-wrapper": "dev-b-1.6 as 1.0.2-RC3",
        "o3-shop/shop-db-views-generator": "^v1.0.0",
        "o3-shop/shop-demodata-installer": "dev-b-1.6 as 1.0.1",
        "o3-shop/shop-composer-plugin": "^v1.1.0",
        "o3-shop/shop-unified-namespace-generator": "dev-b-1.6 as 1.0.1",
        "o3-shop/shop-facts": "dev-b-1.6 as 1.0.5"
    },
    "require-dev": {
        "o3-shop/testing-library": "dev-b-1.6 as 1.1.3",
        "incenteev/composer-parameter-handler": "^2.3",
        "o3-shop/shop-ide-helper": "dev-b-1.6 as 1.0.1",
        "squizlabs/php_codesniffer": "^3.5.4",
        "phpspec/prophecy": "^1.22",
        "rector/rector": "^2.1",
        "phpspec/prophecy-phpunit": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "OxidEsales\\EshopCommunity\\": "./source"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OxidEsales\\EshopCommunity\\Tests\\": "./tests"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": ["bin/oe-console"],
    "scripts": {
        "post-install-cmd": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "@oe:ide-helper:generate"
        ],
        "post-update-cmd": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "@oe:ide-helper:generate"
        ],
        "oe:ide-helper:generate": [
            "if [ -f ./vendor/bin/oe-eshop-ide_helper ]; then oe-eshop-ide_helper; fi"
        ],
        "oe:install:module:paypal": [
            "composer require oxid-solution-catalysts/paypal-module ^2.6.0",
            "vendor/bin/oe-console oe:module:install-configuration source/modules/osc/paypal",
            "vendor/bin/oe-console oe:cache:clear"
        ]
    },
    "extra": {
        "oxideshop": {
            "blacklist-filter": [
                "Application/Component/**/*",
                "Application/Controller/**/*",
                "Application/Model/**/*",
                "Core/**/*",
                "Internal/**/*"
            ]
        },
        "incenteev-parameters": {
            "file": "test_config.yml",
            "dist-file": "vendor/o3-shop/testing-library/test_config.yml.dist",
            "parameter-key": "mandatory_parameters",
            "env-map": {
                "shop_path": "SHOP_PATH",
                "shop_tests_path": "SHOP_TESTS_PATH",
                "partial_module_paths": "PARTIAL_MODULE_PATHS"
            }
        },
        "branch-alias": {
            "dev-b-1.5": "1.5-dev",
            "dev-req/update-dependencies": "1.5-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "o3-shop/shop-composer-plugin": true,
            "o3-shop/shop-unified-namespace-generator": true
        },
        "audit": {
            "ignore": {
                "PKSA-28zg-9h7g-fhvp": "o3-shop/smarty is a maintained fork of smarty/smarty — advisories for upstream do not apply",
                "PKSA-54c6-f9b9-7wg4": "o3-shop/smarty is a maintained fork of smarty/smarty — advisories for upstream do not apply",
                "PKSA-wy1k-8qg5-z8xd": "o3-shop/smarty is a maintained fork of smarty/smarty — advisories for upstream do not apply",
                "PKSA-yr6f-z9sx-cps3": "o3-shop/smarty is a maintained fork of smarty/smarty — advisories for upstream do not apply",
                "PKSA-2q9d-8kh9-49wx": "o3-shop/smarty is a maintained fork of smarty/smarty — advisories for upstream do not apply",
                "PKSA-pght-23ww-rrdy": "o3-shop/smarty is a maintained fork of smarty/smarty — advisories for upstream do not apply",
                "PKSA-6y8p-nrf4-ysf5": "o3-shop/smarty is a maintained fork of smarty/smarty — advisories for upstream do not apply",
                "PKSA-98zc-53yc-qt81": "o3-shop/smarty is a maintained fork of smarty/smarty — advisories for upstream do not apply",
                "PKSA-31hv-m6rg-8ryk": "o3-shop/smarty is a maintained fork of smarty/smarty — advisories for upstream do not apply",
                "PKSA-wc9h-gs49-76tm": "o3-shop/smarty is a maintained fork of smarty/smarty — advisories for upstream do not apply",
                "PKSA-t4kv-1sv2-1mzx": "o3-shop/smarty is a maintained fork of smarty/smarty — advisories for upstream do not apply",
                "PKSA-thph-wfk6-pp4j": "o3-shop/smarty is a maintained fork of smarty/smarty — advisories for upstream do not apply",
                "PKSA-hgp5-21g7-7phg": "o3-shop/smarty is a maintained fork of smarty/smarty — advisories for upstream do not apply"
            }
        }
    },
    "replace": {
        "oxid-esales/oxideshop-ce": "6.10.3"
    }
}
