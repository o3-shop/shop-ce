# PayPal Sandbox credentials for local development.
# Gitignored (see .gitignore). Fill in values from the PayPal Developer Dashboard:
#   https://developer.paypal.com/dashboard/applications/sandbox
# Then apply with:  ./bin/paypal-sandbox-config.sh
#
# REST app credentials (PayPal Checkout module):
OSC_PAYPAL_SANDBOX_CLIENT_ID=""
OSC_PAYPAL_SANDBOX_CLIENT_SECRET=""
#
# Optional — can be created automatically by the module's onboarding.
OSC_PAYPAL_SANDBOX_MERCHANT_ID=""
OSC_PAYPAL_SANDBOX_WEBHOOK_ID=""
#
# Sandbox buyer login used at the PayPal sandbox checkout screen (for reference).
OSC_PAYPAL_SANDBOX_BUYER_EMAIL=""
OSC_PAYPAL_SANDBOX_BUYER_PASSWORD=""
