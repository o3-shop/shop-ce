### important notes
# use integer 0 or 1 for boolean values instead of false or true

### required
## Database
O3SHOP_CONF_DBHOST="db"
O3SHOP_CONF_DBPORT="3306"
O3SHOP_CONF_DBNAME="o3shop"
O3SHOP_CONF_DBUSER="o3shop"
O3SHOP_CONF_DBPWD="o3shop"
O3SHOP_CONF_DBROOT="supersecret"

## URL and paths
O3SHOP_CONF_SHOPURL="http://localhost:8080"
O3SHOP_CONF_SSLSHOPURL="${O3SHOP_CONF_SHOPURL}"
O3SHOP_CONF_SHOPDIR="/var/www/html/source"
O3SHOP_CONF_COMPILEDIR="/var/www/html/source/tmp"

## HTTPS (dev): the container serves https://localhost:8443 with a self-signed cert.
O3SHOP_PORT_HTTPS=8443
# To exercise the SSL mod_rewrite probe locally, point the SSL shop URL at the HTTPS endpoint:
# O3SHOP_CONF_SSLSHOPURL="https://localhost:8443"

### optional
## URL and Paths
O3SHOP_CONF_ADMINSSLURL=""

## MISC
O3SHOP_CONF_LOG_LEVEL="debug" #Log Levels: emergency, alert, critical, error, warning, notice, info, debug
O3SHOP_CONF_UNKNOWN_CONTROLLER_LOG_LEVEL="warning" #Log level for unknown controller key requests (e.g. bot probes); defaults to error if unset
O3SHOP_CONF_LOG_DIR="log" # starting from O3SHOP_CONF_SHOPDIR
O3SHOP_CONF_DEBUG=0
O3SHOP_CONF_ADMINEMAIL=""
O3SHOP_CONF_SKIPVIEWUSAGE=0
O3SHOP_CONF_ALLOWSELFSIGNEDCERTIFICATES=1 # dev only: accept self-signed SSL cert for the setup mod_rewrite probe. Never enable in production.
O3SHOP_CONF_DELSETUPDIR=1
